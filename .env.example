# Kafka used by the local Week 1 development stack
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TELEMETRY_TOPIC=atmosync.telemetry.v1

# Snowflake account details. Copy this file to .env and supply your own values.
SNOWFLAKE_ACCOUNT=<organisation-account>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_INGEST_ROLE=ATMOSYNC_INGESTOR
SNOWFLAKE_DBT_ROLE=ATMOSYNC_TRANSFORMER
SNOWFLAKE_SUPERSET_ROLE=ATMOSYNC_ANALYST
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC
SNOWFLAKE_RAW_SCHEMA=RAW

# Superset local login (development only)
SUPERSET_SECRET_KEY=replace-with-a-long-random-development-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@atmosync.local
